# Warung OS local publisher secrets
# Copy to .env.publish on Raz's Mac only. Never commit real values.
# This file is used only by scripts/publish-snapshot.mjs.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_ONLY_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=warung-os-snapshots
SUPABASE_STORAGE_OBJECT=latest.json
WARUNG_OS_PUBLISH_MAX_AGE_MINUTES=60
