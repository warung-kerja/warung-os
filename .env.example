# Warung OS frontend runtime config
# Copy to .env.local for local browser testing. Do not commit .env.local.

# local = read /snapshots/latest.json from public/ (default)
# prepared = read a hosted-export style JSON from VITE_WARUNG_PREPARED_SNAPSHOT_URL
# remote = read VITE_WARUNG_REMOTE_SNAPSHOT_URL; auth wall is Phase 5.5
VITE_WARUNG_SNAPSHOT_MODE=local

VITE_WARUNG_LOCAL_SNAPSHOT_URL=/snapshots/latest.json
VITE_WARUNG_PREPARED_SNAPSHOT_URL=/hosted-export/latest.json
VITE_WARUNG_REMOTE_SNAPSHOT_URL=

# Use supabase-auth-placeholder to deliberately fail closed until Phase 5.5 auth is implemented.
VITE_WARUNG_REMOTE_AUTH_MODE=none

# Frontend stale-state threshold. The prepared export also embeds max_age_minutes.
VITE_WARUNG_SNAPSHOT_MAX_AGE_MINUTES=60
